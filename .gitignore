# Environment — `.env` holds real local values; `.env.example` is the template.
.env
# Any other environment file, and any signing key or store credential: the
# Android keystore and key.properties (android/.gitignore too), an App Store
# Connect API key (.p8), certificates and provisioning profiles.
.env.*
!.env.example
*.jks
*.keystore
key.properties
*.p8
*.p12
*.pem
*.mobileprovision
secrets.json

# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Offline ESM scoring environment (model weights use Hugging Face's cache).
__pycache__/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Diffs of a failed golden run (tool/goldens/run.sh copies them here).
/test/goldens/failures/
