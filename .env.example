# The deployed backend. Point this at http://localhost:8000 to work against
# a backend running on this machine.
API_BASE_URL=https://helix-peak-backend.onrender.com

API_TIMEOUT_MS=25000

# The lab (/lab and the flows under lib/features/lab/). Off unless this says
# true; a build without the line ships none of it.
LAB_ENABLED=false
