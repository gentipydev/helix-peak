# Copy this file to `.env` before running the app:
#
#   cp .env.example .env
#
# `.env` is gitignored and loaded at startup by flutter_dotenv. It is declared
# as an asset in pubspec.yaml, so the file must exist for the build to succeed
# even while the app is still running against the stub repository.

# Base URL of the HelixPeak FastAPI backend.
API_BASE_URL=http://localhost:8000

# Connect/receive timeout for API requests, in milliseconds.
API_TIMEOUT_MS=15000
