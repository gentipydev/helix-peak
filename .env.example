# The deployed backend. Point this at http://localhost:8000 to work against
# a backend running on this machine.
API_BASE_URL=https://helix-peak-backend.onrender.com

API_TIMEOUT_MS=25000

# Serve the bundled fixture (assets/mock/gene_ins.json) instead of calling the
# backend, for a build that has to run with no service reachable.
# `--dart-define=USE_MOCK_DATA=true` overrides this, and is what release builds
# should use — this file is gitignored.
USE_MOCK_DATA=false
